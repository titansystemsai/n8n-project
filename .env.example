# Copy this file to .env and fill in all values before running agents.
# .env is gitignored — never commit it.

# Supabase — use the SERVICE ROLE key (not anon). Bypasses RLS for agents.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic
ANTHROPIC_API_KEY=

# Hunter.io
HUNTER_IO_API_KEY=your-hunter-api-key

# Apify — used for Facebook scrape step
APIFY_API_KEY=your-apify-api-key

# Brave Search — used in web_search step
BRAVE_SEARCH_API_KEY=your-brave-api-key

# Slack — for error alerts (webhook URL from Slack App)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Org/campaign identifiers — set before each run or pass via --campaign flag
DEFAULT_ORG_ID=
DEFAULT_CAMPAIGN_ID=
